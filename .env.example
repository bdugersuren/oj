# System & Domain
DOMAIN=oj.know.mn
API_DOMAIN=api.oj.know.mn
MINIO_DOMAIN=minio.oj.know.mn
SECRET_KEY=supersecretkey-generate-a-strong-one-for-production-12345
ENABLE_AI=false
ENABLE_JUDGE=true
ENVIRONMENT=production
COOKIE_SECURE=true
# Keep empty for host-only cookies on oj.know.mn
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
POSTGRES_DB=oj_db
POSTGRES_USER=oj_user
POSTGRES_PASSWORD=oj_secure_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://oj_user:oj_secure_password_2026@db:5432/oj_db

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_2026
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://minio.oj.know.mn:9000
MINIO_BUCKET_PROBLEMS=oj-problems
MINIO_BUCKET_SUBMISSIONS=oj-submissions
MINIO_BUCKET_AVATARS=oj-avatars

# DMOJ Bridge & Judge
DMOJ_BRIDGE_HOST=bridge
DMOJ_BRIDGE_HOSTS=bridge1,bridge2
DMOJ_BRIDGE_PORT=9999
DMOJ_JUDGE_NAME=judge-tier3-node1
DMOJ_JUDGE_KEY=dmoj_judge_auth_secret_key_2026
