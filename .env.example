# System & Domain
DOMAIN=oj.know.mn
API_DOMAIN=api.oj.know.mn
MINIO_DOMAIN=minio.oj.know.mn
SECRET_KEY=change-me-with-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-with-an-independent-openssl-rand-hex-32
# Production-д docker-compose.secrets.yml ашиглахдаа нууц утгуудыг .env-д
# бүү хадгал. OJ_SECRET_DIR нь 0600 permission-тэй secret файлын хавтас байна.
OJ_SECRET_DIR=./secrets
ENABLE_AI=false
ENABLE_JUDGE=true
ENVIRONMENT=production
COOKIE_SECURE=true
# Keep empty for host-only cookies on oj.know.mn
COOKIE_DOMAIN=
CORS_ORIGINS=https://oj.example.edu

# PostgreSQL Database
POSTGRES_DB=oj_db
POSTGRES_USER=oj_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://oj_user:change-me-postgres-password@db:5432/oj_db

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=https://minio.example.edu
MINIO_BUCKET_PROBLEMS=oj-problems
MINIO_BUCKET_SUBMISSIONS=oj-submissions
MINIO_BUCKET_AVATARS=oj-avatars

# DMOJ Bridge & Judge
DMOJ_BRIDGE_HOST=bridge
DMOJ_BRIDGE_HOSTS=bridge1,bridge2
DMOJ_BRIDGE_PORT=9999
DMOJ_JUDGE_NAME=judge-tier3-node1

# Optional admin tools
PGADMIN_DEFAULT_EMAIL=admin@example.edu
# pgAdmin password is read from OJ_SECRET_DIR/pgadmin_default_password in production.
# Open WebUI generates and persists its signing key in openwebuidata. Its first
# account must be bootstrapped through the localhost-only port, then signup closed.
OPEN_WEBUI_CORS_ORIGINS=https://ai-admin.example.edu
OPEN_WEBUI_EMBEDDING_MODEL=nomic-embed-text
# Email verification is disabled until every SMTP value is configured.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=OJ Platform
