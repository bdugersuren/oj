# System & Domain
DOMAIN=oj.know.mn
API_DOMAIN=api.oj.know.mn
MINIO_DOMAIN=minio.oj.know.mn
SECRET_KEY=change-me-with-openssl-rand-hex-32
ENABLE_AI=false
ENABLE_JUDGE=true
ENVIRONMENT=production
COOKIE_SECURE=true
# Keep empty for host-only cookies on oj.know.mn
COOKIE_DOMAIN=
CORS_ORIGINS=https://oj.example.edu

# PostgreSQL Database
POSTGRES_DB=oj_db
POSTGRES_USER=oj_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://oj_user:change-me-postgres-password@db:5432/oj_db

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=https://minio.example.edu
MINIO_BUCKET_PROBLEMS=oj-problems
MINIO_BUCKET_SUBMISSIONS=oj-submissions
MINIO_BUCKET_AVATARS=oj-avatars

# DMOJ Bridge & Judge
DMOJ_BRIDGE_HOST=bridge
DMOJ_BRIDGE_HOSTS=bridge1,bridge2
DMOJ_BRIDGE_PORT=9999
DMOJ_JUDGE_NAME=judge-tier3-node1
DMOJ_JUDGE_KEY=change-me-with-an-independent-random-secret

# Optional admin tools
WEBUI_SECRET_KEY=change-me-with-openssl-rand-hex-32
PGADMIN_DEFAULT_EMAIL=admin@example.edu
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
